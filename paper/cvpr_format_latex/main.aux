\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces The one-variable test. Effect of replacing label-style noise fill with the real-intensity remap, \emph  {holding the partition and per-region statistics fixed}, on out-of-domain performance. On \emph  {Dice} the effect is large on both no-tissue-interface tasks and absent -- in one case mildly negative -- on both tissue-interface ones. On \emph  {HD95} the separation is not clean: boundary distance also improves on CHAOS T1in, and only CHAOS T2spir degrades. HD95 in mm; negative is better.\relax }}{7}{table.caption.14}\protected@file@percent }
\newlabel{tab:dissociation}{{2}{7}{The one-variable test. Effect of replacing label-style noise fill with the real-intensity remap, \emph {holding the partition and per-region statistics fixed}, on out-of-domain performance. On \emph {Dice} the effect is large on both no-tissue-interface tasks and absent -- in one case mildly negative -- on both tissue-interface ones. On \emph {HD95} the separation is not clean: boundary distance also improves on CHAOS T1in, and only CHAOS T2spir degrades. HD95 in mm; negative is better.\relax }{table.caption.14}{}}
\newlabel{tab:dissociation@cref}{{[table][2][]2}{[1][7][]7}}
