\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Mechanism ablation (top five rows, additive, no Auglab) and deployment composability check (bottom row). Each rung adds exactly one PALETTE component on top of the row above; all-modality Dice (\%), averaged over held-out test contrasts, folds 0--2, train fraction $50\%$. Intermediate $k$-means/label-remap/Voronoi rungs and the standalone \textbf  {Ours} rung are available for Open-MS and CHAOS; BraTS and ON-Harmony currently report only Base and the deployed configuration, with the intermediate rungs and standalone \textbf  {Ours} pending.\relax }}{3}{table.caption.36}\protected@file@percent }
\newlabel{tab:mechanism}{{6}{3}{Mechanism ablation (top five rows, additive, no Auglab) and deployment composability check (bottom row). Each rung adds exactly one PALETTE component on top of the row above; all-modality Dice (\%), averaged over held-out test contrasts, folds 0--2, train fraction $50\%$. Intermediate $k$-means/label-remap/Voronoi rungs and the standalone \textbf {Ours} rung are available for Open-MS and CHAOS; BraTS and ON-Harmony currently report only Base and the deployed configuration, with the intermediate rungs and standalone \textbf {Ours} pending.\relax }{table.caption.36}{}}
