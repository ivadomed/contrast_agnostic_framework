\@writefile{lot}{\contentsline {table}{\numberline {12}{\ignorespaces Applying PALETTE at validation time as well as at training time, all five tasks. The two configurations are statistically indistinguishable at task level (Dice $p = 0.73$, HD95 $p = 1.00$, same task-stratified test as \cref  {tab:meta}), so we report the like-for-like \emph  {val000} configuration in the main paper and note \emph  {val100} as a free additional gain where it helps -- it requires no extra data, annotation or training cost, only applying the same transform to the validation split. Liver-HCC's own Dice moves the other way (49.7 $\to $ 49.1), which is why \textbf  {overall} Dice is an exact wash across the two configurations.\relax }}{5}{table.caption.48}\protected@file@percent }
\newlabel{tab:suppl-val100}{{12}{5}{Applying PALETTE at validation time as well as at training time, all five tasks. The two configurations are statistically indistinguishable at task level (Dice $p = 0.73$, HD95 $p = 1.00$, same task-stratified test as \cref {tab:meta}), so we report the like-for-like \emph {val000} configuration in the main paper and note \emph {val100} as a free additional gain where it helps -- it requires no extra data, annotation or training cost, only applying the same transform to the validation split. Liver-HCC's own Dice moves the other way (49.7 $\to $ 49.1), which is why \textbf {overall} Dice is an exact wash across the two configurations.\relax }{table.caption.48}{}}
\newlabel{tab:suppl-val100@cref}{{[table][12][]12}{[1][5][]5}}
\@writefile{lot}{\contentsline {table}{\numberline {13}{\ignorespaces Mechanism ablation (top five rows, additive, no Auglab) and deployment composability check (bottom row). Each rung adds exactly one PALETTE component on top of the row above; all-modality Dice (\%), averaged over held-out test contrasts, folds 0--2, train fraction $50\%$. BraTS and ON-Harmony report their T1n/T1w settings, matching every other table in this paper. The deployed row matches \cref  {tab:suppl-dice}'s \textbf  {Ours} column exactly.\relax }}{5}{table.caption.49}\protected@file@percent }
\newlabel{tab:mechanism}{{13}{5}{Mechanism ablation (top five rows, additive, no Auglab) and deployment composability check (bottom row). Each rung adds exactly one PALETTE component on top of the row above; all-modality Dice (\%), averaged over held-out test contrasts, folds 0--2, train fraction $50\%$. BraTS and ON-Harmony report their T1n/T1w settings, matching every other table in this paper. The deployed row matches \cref {tab:suppl-dice}'s \textbf {Ours} column exactly.\relax }{table.caption.49}{}}
