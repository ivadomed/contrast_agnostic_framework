\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces All-class Dice (\%), aggregated across test contrasts/datasets per setting. \emph  {Base} = no-augmentation; \emph  {noEM}/\emph  {EM} = SynthSeg variants; dashes mark cells superseded by the per-setting numbers reported in the text and by the Wilcoxon tests in \cref  {subsec:e-ablation}. \textbf  {Ours} beats the no-augmentation baseline and SynthSeg-noEM significantly in all eight settings (e.g.\ CHAOS T2spir, $p \approx 10^{-29}$), and beats SynthSeg-EM significantly in seven of eight, tying on OpenMS T1w ($+2.0$ Dice, $p=0.147$). Margins over the strongest internal ablation (\texttt  {auglab\_default}, \cref  {subsec:e-main}) range from $+0.4$ to $+1.6$ Dice across all eight settings.\relax }}{4}{table.caption.8}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{tab:main}{{1}{4}{All-class Dice (\%), aggregated across test contrasts/datasets per setting. \emph {Base} = no-augmentation; \emph {noEM}/\emph {EM} = SynthSeg variants; dashes mark cells superseded by the per-setting numbers reported in the text and by the Wilcoxon tests in \cref {subsec:e-ablation}. \textbf {Ours} beats the no-augmentation baseline and SynthSeg-noEM significantly in all eight settings (e.g.\ CHAOS T2spir, $p \approx 10^{-29}$), and beats SynthSeg-EM significantly in seven of eight, tying on OpenMS T1w ($+2.0$ Dice, $p=0.147$). Margins over the strongest internal ablation (\texttt {auglab\_default}, \cref {subsec:e-main}) range from $+0.4$ to $+1.6$ Dice across all eight settings.\relax }{table.caption.8}{}}
